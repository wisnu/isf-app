# Copy ke infra/.env. docker-compose load otomatis.

# Session cookie signing secret. Rotate utk force-logout semua.
SESSION_SECRET=dev-secret-change-me

# Google OAuth (kosong = tombol Google di UI disabled)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:7000/api/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=ihsansolusi.co.id
GOOGLE_ALLOWED_EMAILS=

# Provider toggle (comma separated)
AUTH_PROVIDERS=password,google

# Frontend base utk SSO redirect-back
FRONTEND_BASE_URL=http://localhost:5173
