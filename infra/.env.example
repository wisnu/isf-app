# infra/.env — copy ke infra/.env (di-load otomatis oleh docker compose / podman-compose
# saat berjalan dari direktori infra/). Berlaku untuk kedua stack (zakat & wakaf).

# === LAN access (akses dari HP / device lain di network sama) ===
# Default kosong → portal pakai 'localhost' (akses dari host saja).
# Set ke LAN-IP host untuk akses dari perangkat lain di Wi-Fi yang sama.
# Setelah set, restart kedua stack agar Vite + CORS pakai LAN-IP.
# Buka firewall juga (lihat runbook §16).
HOST_IP=

# === Existing Postgres (Fase 2+) ===
# DSN ke existing DB. 'host.containers.internal' = host gateway dari podman/docker rootless.
# Pastikan postgres listen_addresses='*' dan pg_hba.conf allow user 'transaction'.
DATABASE_URL_ZAKAT=postgresql://transaction:solusi@host.containers.internal:5432/mziss_laz
DATABASE_URL_WAKAF=postgresql://transaction:solusi@host.containers.internal:5432/mziss_wakaf

# === Session secrets ===
# Rotate untuk force-logout semua user di stack terkait (lihat runbook §14).
SESSION_SECRET_ZAKAT=dev-secret-zakat-change-me
SESSION_SECRET_WAKAF=dev-secret-wakaf-change-me

# === Auth providers (csv) ===
# "password" → form login lokal (bcrypt + SQLite).
# "google"   → OAuth2/OIDC; aktif kalau client_id+secret di bawah ter-set.
AUTH_PROVIDERS=password,google

# === Google OAuth ===
# Kredensial dari GCP Console → APIs & Services → Credentials → OAuth 2.0 Client.
# Kosongkan untuk disable Google SSO (tombol di UI jadi disabled).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Redirect URI per portal — wajib match dengan yang terdaftar di GCP.
GOOGLE_OAUTH_REDIRECT_URL_ZAKAT=http://localhost:7000/api/auth/google/callback
GOOGLE_OAUTH_REDIRECT_URL_WAKAF=http://localhost:7001/api/auth/google/callback

# Allowlist: comma-separated. Email harus match domain ATAU email spesifik.
GOOGLE_ALLOWED_DOMAINS=ihsansolusi.co.id
GOOGLE_ALLOWED_EMAILS=

# === Frontend base URL (untuk SSO redirect-back) ===
FRONTEND_BASE_URL_ZAKAT=http://localhost:5173
FRONTEND_BASE_URL_WAKAF=http://localhost:5174
